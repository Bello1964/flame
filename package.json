{
  "name": "carbon-accounting",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "npm run dev -w @carbon/api",
    "dev:web": "npm run dev -w @carbon/web",
    "build:shared": "npm run build -w @carbon/shared",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  }
}
