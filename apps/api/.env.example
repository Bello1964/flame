# Copy to apps/api/.env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Host port 5434 matches docker-compose.yml (avoids local PostgreSQL services on 5432/5433).
#
# Two database users:
# - MIGRATION_DATABASE_URL: the schema owner. Used only by Prisma migrations and
#   `npm run db:create-app-user`.
# - DATABASE_URL: the restricted login the API connects as (member of flame_app). It can
#   only append to and read the audit log, and cannot alter tables or disable triggers.
#   Pick your own password (12+ characters), then run:
#   npm run db:create-app-user -w @flame/api
MIGRATION_DATABASE_URL=postgresql://flame:flame_local_dev_only@localhost:5434/flame?schema=public
DATABASE_URL=postgresql://flame_app_user:choose-a-local-password@localhost:5434/flame?schema=public

# Integration tests: `npm test` does NOT read this file. By default the tests use
# flame_test on the local Docker server (created automatically). To use another
# server (e.g. in CI), set TEST_DATABASE_URL in the shell or CI environment; the database
# name must end in _test. Use a dedicated or throwaway server, never a shared one.

# Origin of the web app; state-changing requests from any other Origin are rejected
WEB_ORIGIN=http://localhost:5173

# Reverse-proxy hops to trust for client IPs: 0 locally, 1 on Render. If this is 0 behind a
# proxy, every user shares the proxy's IP and the per-IP sign-in limit (the API warns once).
TRUST_PROXY=0

# Sessions: idle timeout and absolute lifetime
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Failed sign-in attempts allowed per window:
#   per client IP; per account from one IP; per account from all IPs combined
LOGIN_RATE_LIMIT_MAX=10
LOGIN_ACCOUNT_RATE_LIMIT_MAX=5
LOGIN_ACCOUNT_GLOBAL_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Development seed only (npm run db:seed -w @flame/api). Choose your own values.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
