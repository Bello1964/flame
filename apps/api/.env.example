# Copy to apps/api/.env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml (host port 5434 avoids local PostgreSQL services on 5432/5433)
DATABASE_URL=postgresql://carbon:carbon_local_dev_only@localhost:5434/carbon_accounting?schema=public

# Origin of the web app, for CORS/cookie configuration
WEB_ORIGIN=http://localhost:5173
