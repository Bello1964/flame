// Prisma schema for the Flame API (internal package @flame/api).
// Every schema change must go through `npm run prisma:migrate -w @flame/api`.
// See docs/architecture/ARCHITECTURAL_WORKFLOW.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased and trimmed; uniqueness is case-insensitive by construction.
  email           String     @unique @db.VarChar(320)
  name            String     @db.VarChar(200)
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  /// Platform-level operations only. Grants no implicit access to tenant data.
  isPlatformAdmin Boolean    @default(false)
  /// The one Platform Administrator who may remove others' platform administration rights.
  /// At most one user (partial unique index); requires isPlatformAdmin (CHECK).
  isSupremeAdmin  Boolean    @default(false)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
  auditLogs   AuditLog[]

  createdFacilities   Facility[]    @relation("FacilityCreatedBy")
  createdAssets       Asset[]       @relation("AssetCreatedBy")
  createdFlareSources FlareSource[] @relation("FlareSourceCreatedBy")

  createdActivityRecords   ActivityRecord[]      @relation("ActivityRecordCreatedBy")
  updatedActivityRecords   ActivityRecord[]      @relation("ActivityRecordUpdatedBy")
  withdrawnActivityRecords ActivityRecord[]      @relation("ActivityRecordWithdrawnBy")
  acknowledgedOverlaps     ActivityRecord[]      @relation("ActivityRecordOverlapAcknowledgedBy")
  claimedActivityRecords   ActivityRecord[]      @relation("ActivityRecordClaimedBy")
  approvedActivityRecords  ActivityRecord[]      @relation("ActivityRecordApprovedBy")
  activityRecordEvents     ActivityRecordEvent[]

  createdEditions       MethodologyEdition[] @relation("EditionCreatedBy")
  approvedEditions      MethodologyEdition[] @relation("EditionApprovedBy")
  createdCompositions   GasComposition[]     @relation("CompositionCreatedBy")
  withdrawnCompositions GasComposition[]     @relation("CompositionWithdrawnBy")
  createdEfficiencies   FlareEfficiency[]    @relation("EfficiencyCreatedBy")
  withdrawnEfficiencies FlareEfficiency[]    @relation("EfficiencyWithdrawnBy")
  createdCalculations   Calculation[]        @relation("CalculationCreatedBy")
  updatedCalculations   Calculation[]        @relation("CalculationUpdatedBy")
  claimedCalculations   Calculation[]        @relation("CalculationClaimedBy")
  approvedCalculations  Calculation[]        @relation("CalculationApprovedBy")
  calculationEvents     CalculationEvent[]

  sentInvitations     Invitation[] @relation("InvitationInvitedBy")
  acceptedInvitations Invitation[] @relation("InvitationAcceptedBy")
  revokedInvitations  Invitation[] @relation("InvitationRevokedBy")

  @@map("users")
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  /// Per-session CSRF secret, compared against the X-CSRF-Token header.
  csrfToken  String    @db.VarChar(64)
  userId     String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  /// Absolute expiry. Idle expiry is enforced from lastSeenAt.
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  ipAddress  String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

model Organisation {
  id                              String             @id @default(uuid(7)) @db.Uuid
  name                            String             @db.VarChar(200)
  /// URL-safe unique identifier.
  slug                            String             @unique @db.VarChar(100)
  /// ISO 3166-1 alpha-2.
  country                         String             @default("NG") @db.Char(2)
  status                          OrganisationStatus @default(ACTIVE)
  /// Default source reference condition that prefills new activity records. Initially
  /// ISO 13443 (15 °C, 101.325 kPa absolute). See ARCHITECTURAL_WORKFLOW.md §4.1.
  defaultReferenceTemperature     Decimal            @default(15) @db.Decimal(30, 10)
  defaultReferenceTemperatureUnit TemperatureUnit    @default(CELSIUS)
  defaultReferencePressure        Decimal            @default(101.325) @db.Decimal(30, 10)
  defaultReferencePressureUnit    PressureUnit       @default(KPA_ABS)
  /// Compressibility factors for the default condition (at it, and at ISO 13443) with their
  /// source. Only when the default differs from ISO 13443; they prefill matching records.
  defaultZSource                  Decimal?           @db.Decimal(12, 6)
  defaultZReference               Decimal?           @db.Decimal(12, 6)
  defaultCompressibilitySource    String?            @db.VarChar(500)
  createdAt                       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime           @updatedAt @db.Timestamptz(3)

  memberships          Membership[]
  facilities           Facility[]
  assets               Asset[]
  flareSources         FlareSource[]
  activityRecords      ActivityRecord[]
  activityRecordEvents ActivityRecordEvent[]
  gasCompositions      GasComposition[]
  flareEfficiencies    FlareEfficiency[]
  calculations         Calculation[]
  calculationEvents    CalculationEvent[]
  auditLogs            AuditLog[]
  invitations          Invitation[]

  @@map("organisations")
}

enum Role {
  ORGANISATION_OWNER
  ADMINISTRATOR
  APPROVER
  REVIEWER
  DATA_ENTRY_OFFICER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  /// Removed from the organisation. Kept for history, never deleted; a new invitation
  /// reactivates the same row.
  REMOVED
}

/// A user's membership of one organisation. A user may hold several roles.
model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @db.Uuid
  organisationId String           @db.Uuid
  roles          Role[]
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@map("memberships")
}

// ─── Invitations and email (Milestone 6) ─────────────────────────────────────
// Rules: docs/architecture/ARCHITECTURAL_WORKFLOW.md §7.2.

enum InvitationKind {
  ORGANISATION
  PLATFORM_ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  /// Set lazily: a PENDING invitation past expiresAt is treated as expired everywhere.
  EXPIRED
}

/// An invitation to join an organisation (with roles) or to become a Platform
/// Administrator. Only the SHA-256 hash of the link token is stored. Partial unique indexes
/// (in the migration) allow one PENDING invitation per (organisation, email) and one
/// PENDING platform-administrator invitation per email. Never deleted.
model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  kind             InvitationKind
  /// Required for ORGANISATION, null for PLATFORM_ADMIN (CHECK).
  organisationId   String?          @db.Uuid
  /// Trimmed and lower-cased.
  email            String           @db.VarChar(320)
  /// Non-empty for ORGANISATION, empty for PLATFORM_ADMIN (CHECK).
  roles            Role[]
  tokenHash        String           @unique @db.Char(64)
  invitedById      String           @db.Uuid
  /// Issued by a Platform Administrator through the platform Owner invitation (creating an
  /// organisation, or reviving a dormant one), not by a member. Such an invitation can be
  /// accepted only while the organisation is still dormant. Never changes.
  issuedByPlatform Boolean          @default(false)
  expiresAt        DateTime         @db.Timestamptz(3)
  status           InvitationStatus @default(PENDING)
  acceptedById     String?          @db.Uuid
  /// When it was accepted or declined.
  respondedAt      DateTime?        @db.Timestamptz(3)
  revokedById      String?          @db.Uuid
  revokedAt        DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy    User          @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy   User?         @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy    User?         @relation("InvitationRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  emails       EmailOutbox[]

  @@index([organisationId, status])
  @@index([kind, status])
  @@index([email])
  @@map("invitations")
}

enum EmailTemplate {
  ORGANISATION_INVITATION
  PLATFORM_ADMIN_INVITATION
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  /// Not sent: the invitation was revoked, declined or accepted (or expired) first.
  CANCELLED
}

/// How a SENT email left the outbox.
enum EmailTransport {
  RESEND
  /// Development only: kept in the outbox (with its link) and shown at GET /dev/mailbox.
  DEV_MAILBOX
  /// Tests: an in-memory sender.
  MEMORY
}

/// Transactional outbox: written in the same transaction as the change that needs the
/// email, delivered by the worker in the API process. Any link is erased from the payload
/// once the email is sent (except in the development mailbox) or has finally failed.
model EmailOutbox {
  id                String          @id @default(uuid(7)) @db.Uuid
  recipient         String          @db.VarChar(320)
  template          EmailTemplate
  /// Template data, including the accept link until it is erased.
  payload           Json
  status            EmailStatus     @default(PENDING)
  attempts          Int             @default(0)
  nextAttemptAt     DateTime        @default(now()) @db.Timestamptz(3)
  /// When the current SENDING claim was taken; a stale claim is recovered by the worker.
  claimedAt         DateTime?       @db.Timestamptz(3)
  /// Truncated; never contains secrets or the link.
  lastError         String?         @db.VarChar(500)
  sentAt            DateTime?       @db.Timestamptz(3)
  transport         EmailTransport?
  providerMessageId String?         @db.VarChar(200)
  invitationId      String?         @db.Uuid
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt])
  @@index([invitationId])
  @@map("email_outbox")
}

// ─── Operational hierarchy: Facility → Asset → Flare Source ──────────────────
// Records are archived, never hard-deleted, so historical activity data stays traceable.
// Child rows carry organisationId and a composite FK to their parent, so the database
// itself rejects a child whose parent belongs to another organisation.

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

model Facility {
  id             String       @id @default(uuid(7)) @db.Uuid
  organisationId String       @db.Uuid
  name           String       @db.VarChar(200)
  /// Organisation-defined reference code, unique within the organisation.
  code           String       @db.VarChar(50)
  description    String?      @db.VarChar(2000)
  /// Nigerian state or equivalent first-level region.
  region         String?      @db.VarChar(100)
  country        String       @default("NG") @db.Char(2)
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  /// IANA time zone that defines activity days and periods at this facility.
  timeZone       String       @default("Africa/Lagos") @db.VarChar(64)
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User         @relation("FacilityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assets       Asset[]

  @@unique([organisationId, code])
  @@unique([organisationId, id])
  @@index([organisationId, status])
  @@map("facilities")
}

model Asset {
  id             String       @id @default(uuid(7)) @db.Uuid
  organisationId String       @db.Uuid
  facilityId     String       @db.Uuid
  name           String       @db.VarChar(200)
  code           String       @db.VarChar(50)
  /// Free text for now (e.g. flow station, gas plant, FPSO); to become a managed list.
  assetType      String?      @db.VarChar(100)
  description    String?      @db.VarChar(2000)
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facility     Facility      @relation(fields: [organisationId, facilityId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User          @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  flareSources FlareSource[]

  @@unique([organisationId, code])
  @@unique([organisationId, id])
  @@index([organisationId, facilityId])
  @@map("assets")
}

enum FlareType {
  ELEVATED
  GROUND
  ENCLOSED
  OTHER
}

model FlareSource {
  id             String        @id @default(uuid(7)) @db.Uuid
  organisationId String        @db.Uuid
  assetId        String        @db.Uuid
  name           String        @db.VarChar(200)
  code           String        @db.VarChar(50)
  /// Optional until confirmed; calculation inputs are captured with methodology data later.
  flareType      FlareType?
  /// Production or refinery service: decides which methodology defaults may apply (§8.1).
  flareService   FlareService?
  description    String?       @db.VarChar(2000)
  status         RecordStatus  @default(ACTIVE)
  archivedAt     DateTime?     @db.Timestamptz(3)
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset           Asset             @relation(fields: [organisationId, assetId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User              @relation("FlareSourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activityRecords ActivityRecord[]
  gasCompositions GasComposition[]
  efficiencies    FlareEfficiency[]
  calculations    Calculation[]

  @@unique([organisationId, code])
  @@unique([organisationId, id])
  @@index([organisationId, assetId])
  @@map("flare_sources")
}

// ─── Gas activity data (Milestone 2) ─────────────────────────────────────────
// Operational quantities only; no emissions are calculated from these records yet.
// Rules: docs/architecture/ARCHITECTURAL_WORKFLOW.md §4.1.

enum ActivityRecordKind {
  DAILY
  PERIOD
}

enum ActivityType {
  ROUTINE_FLARING
  NON_ROUTINE_FLARING
  EMERGENCY_FLARING
  VENTING
  OTHER_RELEASE
}

enum MeasurementBasis {
  MEASURED
  ESTIMATED
}

enum MeasurementMethod {
  METERED
  CALCULATED
  ENGINEERING_ESTIMATE
  OTHER
}

enum ActivityDataSource {
  MANUAL
}

/// Workflow: ARCHITECTURAL_WORKFLOW.md §7 and §7.1. Legal transitions are also
/// enforced by a database trigger (see the review-approval migration).
enum ActivityRecordStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CORRECTION
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
  WITHDRAWN
}

enum RateUnit {
  MMSCF_PER_DAY
  SM3_PER_DAY
  MMSM3_PER_DAY
}

enum VolumeUnit {
  MMSCF
  BCF
  SM3
  MMSM3
}

enum TemperatureUnit {
  CELSIUS
  FAHRENHEIT
  KELVIN
}

/// Absolute pressure only; gauge pressure is not accepted.
enum PressureUnit {
  KPA_ABS
  BAR_ABS
  PSIA
}

model ActivityRecord {
  id                   String             @id @default(uuid(7)) @db.Uuid
  organisationId       String             @db.Uuid
  flareSourceId        String             @db.Uuid
  kind                 ActivityRecordKind
  activityType         ActivityType
  /// Required for OTHER_RELEASE.
  otherTypeDescription String?            @db.VarChar(500)
  /// Inclusive local dates in timeZone. A daily record has periodStart = periodEnd.
  periodStart          DateTime           @db.Date
  periodEnd            DateTime           @db.Date
  /// The facility's time zone when the record was saved.
  timeZone             String             @db.VarChar(64)

  // Quantities as submitted: exact decimal plus the text exactly as entered.
  averageRate         Decimal?    @db.Decimal(30, 10)
  averageRateInput    String?     @db.VarChar(40)
  rateUnit            RateUnit?
  totalVolume         Decimal?    @db.Decimal(30, 10)
  totalVolumeInput    String?     @db.VarChar(40)
  volumeUnit          VolumeUnit?
  operatingHours      Decimal?    @db.Decimal(30, 10)
  operatingHoursInput String?     @db.VarChar(40)

  // Source reference condition (absolute) and compressibility factors.
  referenceTemperature      Decimal         @db.Decimal(30, 10)
  referenceTemperatureInput String          @db.VarChar(40)
  referenceTemperatureUnit  TemperatureUnit
  referencePressure         Decimal         @db.Decimal(30, 10)
  referencePressureInput    String          @db.VarChar(40)
  referencePressureUnit     PressureUnit
  /// Required when the source condition differs from the canonical one.
  zSource                   Decimal?        @db.Decimal(12, 6)
  zSourceInput              String?         @db.VarChar(40)
  zReference                Decimal?        @db.Decimal(12, 6)
  zReferenceInput           String?         @db.VarChar(40)
  /// Where the Z values come from (e.g. the organisation default's source). Only with Z.
  compressibilitySource     String?         @db.VarChar(500)

  measurementBasis    MeasurementBasis
  /// Required when ESTIMATED.
  estimateExplanation String?            @db.VarChar(2000)
  measurementMethod   MeasurementMethod
  /// Required when OTHER.
  methodDescription   String?            @db.VarChar(500)
  dataSource          ActivityDataSource @default(MANUAL)
  notes               String?            @db.VarChar(2000)

  // Standardised to the canonical condition (ISO 13443), computed server-side at save.
  standardRateMmscfd  Decimal? @db.Decimal(40, 20)
  standardVolumeMmscf Decimal? @db.Decimal(40, 20)
  /// rate × operatingHours / 24, only when both are present.
  derivedVolumeMmscf  Decimal? @db.Decimal(40, 20)
  /// (P_src / P_ref) × (T_ref / T_src) × (Z_ref / Z_src); 1 at the canonical condition.
  correctionFactor    Decimal  @db.Decimal(40, 20)
  conversionVersion   String   @db.VarChar(40)
  /// Formula, constants and absolute inputs used, for reproduction.
  conversionDetails   Json
  standardisedAt      DateTime @db.Timestamptz(3)

  status                  ActivityRecordStatus @default(DRAFT)
  withdrawnAt             DateTime?            @db.Timestamptz(3)
  withdrawnById           String?              @db.Uuid
  withdrawalReason        String?              @db.VarChar(2000)
  /// Set when the user saved despite an overlap warning.
  overlapAcknowledgedAt   DateTime?            @db.Timestamptz(3)
  overlapAcknowledgedById String?              @db.Uuid

  // Review and approval (Milestone 4, ARCHITECTURAL_WORKFLOW.md §7.1).
  /// The approved record this one revises (same organisation); null for a first version.
  revisionOfId String?   @db.Uuid
  /// 1 for an original record, the revised record's version + 1 for a revision.
  version      Int       @default(1)
  /// Latest submission time; orders the review queue.
  submittedAt  DateTime? @db.Timestamptz(3)
  /// The reviewer who claimed the record; set only while UNDER_REVIEW.
  claimedById  String?   @db.Uuid
  claimedAt    DateTime? @db.Timestamptz(3)
  approvedAt   DateTime? @db.Timestamptz(3)
  approvedById String?   @db.Uuid
  /// When an approved revision of this record replaced it.
  supersededAt DateTime? @db.Timestamptz(3)

  createdById String   @db.Uuid
  updatedById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  organisation          Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  flareSource           FlareSource           @relation(fields: [organisationId, flareSourceId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy             User                  @relation("ActivityRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy             User                  @relation("ActivityRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  withdrawnBy           User?                 @relation("ActivityRecordWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  overlapAcknowledgedBy User?                 @relation("ActivityRecordOverlapAcknowledgedBy", fields: [overlapAcknowledgedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  claimedBy             User?                 @relation("ActivityRecordClaimedBy", fields: [claimedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy            User?                 @relation("ActivityRecordApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisionOf            ActivityRecord?       @relation("ActivityRecordRevisions", fields: [organisationId, revisionOfId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  revisions             ActivityRecord[]      @relation("ActivityRecordRevisions")
  events                ActivityRecordEvent[]
  calculations          Calculation[]

  @@unique([organisationId, id])
  @@index([organisationId, flareSourceId, activityType, periodStart])
  @@index([organisationId, status])
  @@index([organisationId, revisionOfId])
  @@map("activity_records")
}

enum ActivityRecordEventType {
  CREATED
  EDITED
  SUBMITTED
  RECALLED
  REVIEW_STARTED
  CLAIM_RELEASED
  FORWARDED
  RETURNED
  APPROVED
  REJECTED
  WITHDRAWN
  REVISION_CREATED
  SUPERSEDED
}

/// Append-only history of an activity record: every edit, workflow step and comment.
/// Also the source of "involvement" for separation of duties (§7.1).
model ActivityRecordEvent {
  id               String                  @id @default(uuid(7)) @db.Uuid
  organisationId   String                  @db.Uuid
  activityRecordId String                  @db.Uuid
  type             ActivityRecordEventType
  fromStatus       ActivityRecordStatus?
  toStatus         ActivityRecordStatus
  actorId          String                  @db.Uuid
  comment          String?                 @db.VarChar(2000)
  /// E.g. the data-quality warnings when the record was submitted or approved.
  details          Json?
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)

  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activityRecord ActivityRecord @relation(fields: [organisationId, activityRecordId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  actor          User           @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, activityRecordId, createdAt])
  @@map("activity_record_events")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

/// Append-only. Application code never updates or deletes audit rows.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level events (e.g. sign-in).
  organisationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String   @db.VarChar(100)
  entityId       String?  @db.Uuid
  /// Change summary; never contains passwords, tokens or secrets.
  metadata       Json?
  ipAddress      String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Emissions calculations (Milestone 3) ────────────────────────────────────
// Rules: docs/architecture/ARCHITECTURAL_WORKFLOW.md §8.1.

enum FlareService {
  PRODUCTION
  REFINERY
}

enum MethodologyEditionStatus {
  DRAFT
  APPROVED
  SUPERSEDED
  WITHDRAWN
}

enum MethodologyParameterKind {
  UNIT_CONVERSION
  CONSTANT
  MOLECULAR_WEIGHT
  CARBON_NUMBER
  EMISSION_FACTOR
  DEFAULT_ASSUMPTION
  GWP
}

/// A published edition of the calculation methodology: every decision with its reason and
/// references, the formulas, and (in parameters) every number with its source. Shared by
/// all organisations, maintained by Platform Administrators, frozen once approved.
model MethodologyEdition {
  id               String                   @id @default(uuid(7)) @db.Uuid
  /// Stable identifier of the methodology, e.g. "flame-flaring-venting".
  code             String                   @db.VarChar(100)
  edition          Int
  title            String                   @db.VarChar(300)
  summary          String                   @db.VarChar(4000)
  /// Routes, formulas, decisions (decision, reason, references) and limitations.
  content          Json
  status           MethodologyEditionStatus @default(DRAFT)
  /// Who supplied the values when no user created the edition (e.g. imported by a migration).
  provenance       String?                  @db.VarChar(1000)
  createdById      String?                  @db.Uuid
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(3)
  approvedById     String?                  @db.Uuid
  approvedAt       DateTime?                @db.Timestamptz(3)
  supersededAt     DateTime?                @db.Timestamptz(3)
  withdrawnAt      DateTime?                @db.Timestamptz(3)
  withdrawalReason String?                  @db.VarChar(2000)

  createdBy    User?                  @relation("EditionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy   User?                  @relation("EditionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parameters   MethodologyParameter[]
  calculations Calculation[]

  @@unique([code, edition])
  @@map("methodology_editions")
}

/// One sourced number in an edition (constant, factor, default assumption or GWP).
model MethodologyParameter {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  editionId          String                   @db.Uuid
  /// Stable key used by the calculation engine, e.g. "ipcc.molar_volume".
  key                String                   @db.VarChar(100)
  kind               MethodologyParameterKind
  name               String                   @db.VarChar(300)
  value              Decimal                  @db.Decimal(40, 20)
  unit               String                   @db.VarChar(100)
  gas                String?                  @db.VarChar(20)
  appliesTo          String                   @db.VarChar(1000)
  sourceOrganisation String                   @db.VarChar(200)
  sourceDocument     String                   @db.VarChar(500)
  sourceEdition      String                   @db.VarChar(300)
  /// Page, table, footnote or equation.
  sourceLocation     String                   @db.VarChar(500)
  sourceUrl          String?                  @db.VarChar(1000)
  retrievedOn        DateTime                 @db.Date
  notes              String?                  @db.VarChar(2000)

  edition MethodologyEdition @relation(fields: [editionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([editionId, key])
  @@map("methodology_parameters")
}

enum InputRecordStatus {
  ACTIVE
  WITHDRAWN
}

/// A dated gas analysis for a flare source. Never edited: a correction is a new analysis.
model GasComposition {
  id                      String            @id @default(uuid(7)) @db.Uuid
  organisationId          String            @db.Uuid
  flareSourceId           String            @db.Uuid
  /// Used for activity whose period starts on or after this local date.
  validFrom               DateTime          @db.Date
  sampleDate              DateTime          @db.Date
  /// Lab report, chromatograph record or similar.
  sampleReference         String            @db.VarChar(300)
  analysisMethod          String?           @db.VarChar(300)
  /// Mole percent, exactly as entered (up to 6 decimal places).
  methane                 Decimal           @db.Decimal(10, 6)
  ethane                  Decimal           @db.Decimal(10, 6)
  propane                 Decimal           @db.Decimal(10, 6)
  isoButane               Decimal           @db.Decimal(10, 6)
  normalButane            Decimal           @db.Decimal(10, 6)
  isoPentane              Decimal           @db.Decimal(10, 6)
  normalPentane           Decimal           @db.Decimal(10, 6)
  hexanesPlus             Decimal           @db.Decimal(10, 6)
  /// Average carbon atoms per molecule of the C6+ fraction; required when C6+ > 0.
  hexanesPlusCarbonNumber Decimal?          @db.Decimal(8, 4)
  carbonDioxide           Decimal           @db.Decimal(10, 6)
  nitrogen                Decimal           @db.Decimal(10, 6)
  hydrogenSulphide        Decimal           @db.Decimal(10, 6)
  otherInerts             Decimal           @db.Decimal(10, 6)
  /// The components exactly as typed.
  entered                 Json
  notes                   String?           @db.VarChar(2000)
  status                  InputRecordStatus @default(ACTIVE)
  withdrawnAt             DateTime?         @db.Timestamptz(3)
  withdrawnById           String?           @db.Uuid
  withdrawalReason        String?           @db.VarChar(2000)
  createdById             String            @db.Uuid
  createdAt               DateTime          @default(now()) @db.Timestamptz(3)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  flareSource  FlareSource   @relation(fields: [organisationId, flareSourceId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User          @relation("CompositionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  withdrawnBy  User?         @relation("CompositionWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calculations Calculation[]

  @@unique([organisationId, id])
  @@index([organisationId, flareSourceId, validFrom])
  @@map("gas_compositions")
}

enum EfficiencyBasis {
  MEASURED_TEST
  VENDOR_SPECIFICATION
  /// e.g. NUPRC's 98% design DRE: a requirement, never used as achieved performance.
  DESIGN_REQUIREMENT
}

/// Flare performance evidence for a flare source. Never edited: a correction is a new record.
model FlareEfficiency {
  id                          String            @id @default(uuid(7)) @db.Uuid
  organisationId              String            @db.Uuid
  flareSourceId               String            @db.Uuid
  validFrom                   DateTime          @db.Date
  basis                       EfficiencyBasis
  /// Percent of hydrocarbon carbon converted to CO2 (or the design DRE for a requirement).
  combustionEfficiencyPercent Decimal           @db.Decimal(9, 6)
  /// Percent of methane leaving uncombusted; required for test and vendor values.
  uncombustedMethanePercent   Decimal?          @db.Decimal(9, 6)
  /// Test report, vendor datasheet or regulation reference.
  sourceReference             String            @db.VarChar(500)
  testDate                    DateTime?         @db.Date
  entered                     Json
  notes                       String?           @db.VarChar(2000)
  status                      InputRecordStatus @default(ACTIVE)
  withdrawnAt                 DateTime?         @db.Timestamptz(3)
  withdrawnById               String?           @db.Uuid
  withdrawalReason            String?           @db.VarChar(2000)
  createdById                 String            @db.Uuid
  createdAt                   DateTime          @default(now()) @db.Timestamptz(3)

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  flareSource  FlareSource   @relation(fields: [organisationId, flareSourceId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User          @relation("EfficiencyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  withdrawnBy  User?         @relation("EfficiencyWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calculations Calculation[]

  @@unique([organisationId, id])
  @@index([organisationId, flareSourceId, validFrom])
  @@map("flare_efficiencies")
}

enum CalculationRoute {
  COMPOSITION_FLARING
  IPCC_REFERENCE_FLARING
  COMPOSITION_VENTING
}

enum EfficiencySource {
  FLARE_RECORD
  METHODOLOGY_DEFAULT
}

enum CalculationStatus {
  CALCULATED
  SUBMITTED
  UNDER_REVIEW
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
  DISCARDED
}

enum DataQuality {
  MEASURED_BASIS
  ESTIMATED
}

/// An immutable, versioned emissions calculation for one approved activity record.
model Calculation {
  id                String            @id @default(uuid(7)) @db.Uuid
  organisationId    String            @db.Uuid
  activityRecordId  String            @db.Uuid
  flareSourceId     String            @db.Uuid
  /// 1, 2, ... per activity record.
  version           Int
  route             CalculationRoute
  editionId         String            @db.Uuid
  efficiencySource  EfficiencySource?
  flareEfficiencyId String?           @db.Uuid
  gasCompositionId  String?           @db.Uuid
  /// Required for the IPCC reference-case route.
  fallbackReason    String?           @db.VarChar(2000)
  notes             String?           @db.VarChar(2000)
  /// Every input and parameter used, with values and sources, as at calculation time.
  inputs            Json
  /// Each step: formula, substituted values, result and the parameters it used.
  steps             Json
  engineVersion     String            @db.VarChar(40)
  volumeM3          Decimal           @db.Decimal(40, 20)
  co2Tonnes         Decimal           @db.Decimal(40, 20)
  ch4Tonnes         Decimal           @db.Decimal(40, 20)
  /// Null where N2O doesn't apply (venting).
  n2oTonnes         Decimal?          @db.Decimal(40, 20)
  co2eTonnes        Decimal           @db.Decimal(40, 20)
  dataQuality       DataQuality
  /// Why the result is estimated, as sentences.
  qualityReasons    Json
  status            CalculationStatus @default(CALCULATED)
  submittedAt       DateTime?         @db.Timestamptz(3)
  claimedById       String?           @db.Uuid
  claimedAt         DateTime?         @db.Timestamptz(3)
  approvedAt        DateTime?         @db.Timestamptz(3)
  approvedById      String?           @db.Uuid
  supersededAt      DateTime?         @db.Timestamptz(3)
  discardedAt       DateTime?         @db.Timestamptz(3)
  createdById       String            @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedById       String            @db.Uuid
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activityRecord ActivityRecord     @relation(fields: [organisationId, activityRecordId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  flareSource    FlareSource        @relation(fields: [organisationId, flareSourceId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  edition        MethodologyEdition @relation(fields: [editionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  efficiency     FlareEfficiency?   @relation(fields: [organisationId, flareEfficiencyId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  composition    GasComposition?    @relation(fields: [organisationId, gasCompositionId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User               @relation("CalculationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy      User               @relation("CalculationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  claimedBy      User?              @relation("CalculationClaimedBy", fields: [claimedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy     User?              @relation("CalculationApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events         CalculationEvent[]

  @@unique([organisationId, id])
  @@unique([activityRecordId, version])
  @@index([organisationId, status])
  @@index([organisationId, activityRecordId])
  @@map("calculations")
}

enum CalculationEventType {
  CALCULATED
  SUBMITTED
  RECALLED
  REVIEW_STARTED
  CLAIM_RELEASED
  FORWARDED
  APPROVED
  REJECTED
  SUPERSEDED
  DISCARDED
}

/// Append-only history of a calculation (also the source of involvement).
model CalculationEvent {
  id             String               @id @default(uuid(7)) @db.Uuid
  organisationId String               @db.Uuid
  calculationId  String               @db.Uuid
  type           CalculationEventType
  fromStatus     CalculationStatus?
  toStatus       CalculationStatus
  actorId        String               @db.Uuid
  comment        String?              @db.VarChar(2000)
  details        Json?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calculation  Calculation  @relation(fields: [organisationId, calculationId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organisationId, calculationId, createdAt])
  @@map("calculation_events")
}
